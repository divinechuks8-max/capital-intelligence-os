# Database connection. Production/dev target is PostgreSQL.
# Tests never read this — they run against an in-memory SQLite engine.
DATABASE_URL=postgresql+psycopg2://capint:capint@localhost:5432/capint

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# Source API credentials
SEC_EDGAR_USER_AGENT="Your Org contact@example.com"

# Free API key from https://developer.company-information.service.gov.uk/
# (self-service signup, create a "Live" REST application, generate a key)
COMPANIES_HOUSE_API_KEY=""

# Free API key from https://www.alphavantage.co/support/#api-key
# (instant self-service signup, free tier: 25 requests/day, ~100 trailing
# trading days of daily price history per symbol)
ALPHA_VANTAGE_API_KEY=""

# Free API key from https://finnhub.io/register (instant self-service
# signup, free tier: 60 calls/minute, aggregate analyst recommendation
# trends only — individual estimates/price targets are a paid feature)
FINNHUB_API_KEY=""
