# Database connection. Production/dev target is PostgreSQL.
# Tests never read this — they run against an in-memory SQLite engine.
DATABASE_URL=postgresql+psycopg2://capint:capint@localhost:5432/capint

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# Source API credentials (placeholders — no adapter reads these yet in this increment)
SEC_EDGAR_USER_AGENT="Your Org contact@example.com"
